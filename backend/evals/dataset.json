{
  "version": 1,
  "description": "Hand-labelled evaluation cases. 'expected' may be a single value or a list of acceptable values (some civic complaints are legitimately ambiguous between neighbouring categories).",
  "classification": [
    {
      "id": "cls-pothole-en",
      "text": "There is a huge pothole on the main road near the school gate, bikes are skidding.",
      "expected": [
        "POTHOLE",
        "ROAD_DAMAGE"
      ],
      "keywords": [
        "pothole"
      ]
    },
    {
      "id": "cls-garbage-en",
      "text": "Garbage has not been collected in our lane for 5 days and it stinks badly.",
      "expected": [
        "GARBAGE",
        "WASTE_COLLECTION"
      ],
      "keywords": [
        "garbage",
        "waste"
      ]
    },
    {
      "id": "cls-waterleak-en",
      "text": "A water pipe is leaking on the road and a lot of clean water is being wasted.",
      "expected": [
        "WATER_LEAKAGE"
      ],
      "keywords": [
        "leak"
      ]
    },
    {
      "id": "cls-watersupply-en",
      "text": "We have had no water supply in our building for two days.",
      "expected": [
        "WATER_SUPPLY"
      ],
      "keywords": [
        "water"
      ]
    },
    {
      "id": "cls-streetlight-en",
      "text": "The streetlight near the bus stop is not working and it is very dark at night.",
      "expected": [
        "STREETLIGHT"
      ],
      "keywords": [
        "light"
      ]
    },
    {
      "id": "cls-signal-en",
      "text": "The traffic signal at the junction has stopped working and cars are jamming.",
      "expected": [
        "TRAFFIC_SIGNAL"
      ],
      "keywords": [
        "signal"
      ]
    },
    {
      "id": "cls-sewage-en",
      "text": "Sewage is overflowing from the manhole onto the road outside the houses.",
      "expected": [
        "SEWERAGE",
        "DRAINAGE"
      ],
      "keywords": [
        "sewage",
        "sewer",
        "manhole",
        "overflow"
      ]
    },
    {
      "id": "cls-tree-en",
      "text": "A big tree branch has broken and is hanging dangerously over the footpath.",
      "expected": [
        "TREE_HAZARD"
      ],
      "keywords": [
        "tree",
        "branch"
      ]
    },
    {
      "id": "cls-deadanimal-en",
      "text": "A dead dog has been lying on the road since this morning.",
      "expected": [
        "DEAD_ANIMAL"
      ],
      "keywords": [
        "dead",
        "animal",
        "dog"
      ]
    },
    {
      "id": "cls-pothole-hinglish",
      "text": "Rasta me bahut bada gadda hai, gaadiyan phas jaati hain aur accident ho sakta hai.",
      "expected": [
        "POTHOLE",
        "ROAD_DAMAGE"
      ],
      "keywords": [
        "pothole",
        "road"
      ]
    },
    {
      "id": "cls-garbage-hindi",
      "text": "हमारे मोहल्ले में कई दिनों से कचरा नहीं उठाया गया है।",
      "expected": [
        "GARBAGE",
        "WASTE_COLLECTION"
      ],
      "keywords": [
        "garbage",
        "waste"
      ]
    },
    {
      "id": "cls-pothole-marathi",
      "text": "रस्त्यावर मोठा खड्डा पडला आहे, वाहनचालकांना त्रास होतो.",
      "expected": [
        "POTHOLE",
        "ROAD_DAMAGE"
      ],
      "keywords": [
        "pothole",
        "road"
      ]
    },
    {
      "id": "cls-encroach-en",
      "text": "Illegal hawkers have completely blocked the footpath outside the station.",
      "expected": [
        "ENCROACHMENT",
        "FOOTPATH_DAMAGE"
      ],
      "keywords": [
        "encroach",
        "footpath",
        "hawker"
      ]
    },
    {
      "id": "cls-toilet-en",
      "text": "The public toilet near the market is filthy and has no running water.",
      "expected": [
        "PUBLIC_TOILET",
        "SANITATION"
      ],
      "keywords": [
        "toilet"
      ]
    },
    {
      "id": "cls-flood-en",
      "text": "Heavy flooding on our street after the rain, water is entering the ground-floor houses.",
      "expected": [
        "FLOODING",
        "DRAINAGE"
