  "validation": [
    {
      "id": "val-not-json",
      "raw": "Sure! Here is the answer: pothole",
      "expected": {
        "success": false
      }
    },
    {
      "id": "val-bad-category",
      "raw": "{\"summary\":\"x\",\"category\":\"ALIEN\"}",
      "expected": {
        "success": true,
        "category": "OTHER"
      }
    },
    {
      "id": "val-good",
      "raw": "{\"summary\":\"Pothole on road\",\"category\":\"POTHOLE\",\"confidence\":0.9}",
      "expected": {
        "success": true,
        "category": "POTHOLE"
      }
    },
    {
      "id": "val-bad-urgency",
      "raw": "{\"summary\":\"x\",\"category\":\"GARBAGE\",\"urgency\":\"NUCLEAR\"}",
      "expected": {
        "success": true,
        "urgency": "NORMAL"
      }
    },
    {
      "id": "val-missing-summary",
      "raw": "{\"category\":\"POTHOLE\"}",
      "expected": {
        "success": false
      }
    },
    {
      "id": "val-html",
      "raw": "{\"summary\":\"<script>bad()</script>Real issue\",\"category\":\"POTHOLE\"}",
      "expected": {
        "success": true,
        "summaryHasNoTags": true
      }
    }
