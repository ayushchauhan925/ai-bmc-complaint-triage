# Server
PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bmc_triage
# Set to REQUIRED (or anything truthy) for a managed/cloud MySQL provider that requires
# TLS (Aiven, PlanetScale, etc.). Leave unset for a local MySQL install.
DB_SSL_MODE=

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# OpenAI (server-side only - never exposed to the frontend)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Image storage (Cloudinary) - server-side only, never exposed to the frontend.
# Get these from your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# CORS - the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173
