# Server
PORT=5000
NODE_ENV=development

# MySQL (Aiven Cloud MySQL in production - see README's Render Deployment section)
DB_HOST=
DB_PORT=28040
DB_USER=
DB_PASSWORD=
DB_NAME=
# REQUIRED for Aiven (or any managed MySQL that mandates TLS). Leave unset for local MySQL.
DB_SSL_MODE=REQUIRED

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# OpenAI (server-side only - never exposed to the frontend)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Image storage (Cloudinary) - server-side only, never exposed to the frontend.
# Get these from your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# CORS - the frontend origin(s) allowed to call this API. Comma-separated for multiple
# (e.g. a production domain + a preview domain). Local dev origins (localhost:5173) are
# always additionally allowed outside of NODE_ENV=production, no need to list them here.
CORS_ORIGIN=http://localhost:5173

# Optional email notifications (SMTP). Leave SMTP_HOST empty to disable the email channel;
# in-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Civic Connect <no-reply@example.com>
# Notification types that are also emailed (comma-separated)
EMAIL_NOTIFY_TYPES=SLA_ESCALATION,ESCALATION,COMPLAINT_ASSIGNED

# Background jobs (SLA checks, escalation rules, anomaly scan, AI retry). Default: on.
ENABLE_BACKGROUND_JOBS=true
# Pending database migrations are applied automatically when the server starts (default).
# Set to false to run `npm run migrate` yourself instead.
AUTO_MIGRATE=true

# --- Account emails (password reset / verification) ---
# Public URL of the deployed frontend, used to build links in emails.
FRONTEND_URL=http://localhost:5173
# Optional: the database provider's CA certificate (PEM text or path). When set, the DB server
# certificate is verified instead of only encrypted.
DB_SSL_CA=

# --- Web Push (optional) ---
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
